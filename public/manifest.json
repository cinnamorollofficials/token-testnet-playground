{
  "manifest_version": 3,
  "name": "Token Testnet Playground",
  "short_name": "Testnet PG",
  "version": "1.0.0",
  "description": "Multi-chain token testing, faucet claiming, and asset transfer playground (EVM, Solana, XRPL, Bitcoin).",
  "action": {
    "default_popup": "index.html",
    "default_title": "Token Testnet Playground",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*/*",
    "wss://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
